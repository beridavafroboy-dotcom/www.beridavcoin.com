ame:"mt-8 rounded-2xl border border-border/50 bg-card/50 p-5",children:[s.jsx("h4",{className:"font-display font-semibold text-sm text-white mb-3",children:"📜 BER Token Smart Contract (Solidity)"}),s.jsx("pre",{className:"bg-background/70 rounded-xl border border-border/40 p-4 text-[11px] text-green-300 font-mono overflow-x-auto",children:`// SPDX-License-Identifier: MIT
pragma solidity ^0.8.0;

contract BERIDAVToken {
    string public name     = "BERIDAV COIN";
    string public symbol   = "BER";
    uint   public totalSupply = 39_000_000_000;

    struct Innovation {
        string  title;
        address creator;
        uint    value;
    }
    mapping(uint => Innovation) public innovations;

    event NFTMinted(uint indexed id, string title, address creator);

    function mintInnovation(uint id, string calldata title) external {
        innovations[id] = Innovation(title, msg.sender, 0);
