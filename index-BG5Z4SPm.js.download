// SPDX-License-Identifier: MIT
pragma solidity ^0.8.20;

contract BERAutoMining {
    address public owner;
    uint256 public totalHashrate;
    uint256 public rewardPool;
    
    mapping(address => uint256) public minerRewards;
    mapping(address => bool) public biometricVerified;
    
    event HashSubmitted(address indexed miner, bytes32 hash, uint256 reward);
    event BiometricVerified(address indexed wallet, uint256 confidence);
    event RFEnergyHarvested(address indexed device, uint256 milliwatts);
    
    modifier onlyVerified() {
        require(biometricVerified[msg.sender], "Biometric auth required");
        _;
    }
    
    // RF Energy Harvesting Registration
    function registerRFHarvest(uint256 _milliwatts, bytes32 _rfSignature) external {
        emit RFEnergyHarvested(msg.sender, _milliwatts);
        totalHashrate += _milliwatts * 1000; // mW → hashrate units
    }
    
    // Submit mining proof-of-work share
    function submitShare(bytes32 _blockHash, uint256 _nonce) 
        external onlyVerified returns (bool) {
        uint256 reward = calculateReward(_blockHash);
        minerRewards[msg.sender] += reward;
        emit HashSubmitted(msg.sender, _blockHash, reward);
        return true;
    }
    
    // AI Forensic biometric verification on-chain
    function verifyBiometric(address _wallet, uint256 _confidence) 
        external {
        require(_confidence >= 95, "Confidence < 95% threshold");
        biometricVerified[_wallet] = true;
        emit BiometricVerified(_wallet, _confidence);
    }
    
    function calculateReward(bytes32 hash) internal view returns (uint256) {
        return rewardPool / (uint256(hash[0]) + 1);
    }
    
    function claimRewards() external onlyVerified {
        uint256 amount = minerRewards[msg.sender];
        minerRewards[msg.sender] = 0;
        payable(msg.sender).transfer(amount);
    }
}`;function tje({totalBTC:e,miningActive:t}){return s.jsxs("div",{className:"space-y-4",children:[s.jsxs("div",{className:"rounded-2xl border border-border/40 bg-card/50 p-5",children:[s.jsxs("h3",{className:"font-display font-bold text-white mb-4 flex items-center gap-2",children:[s.jsx("span",{children:"⛓️"})," Multi-Chain Bridge · BERIDAV Protocol"]}),s.jsx("div",{className:"space-y-2",children:ZSe.map((r,n)=>s.jsxs(ae.div,{initial:{opacity:0,x:-6},animate:{opacity:1,x:0},transition:{delay:n*.07},className:"flex items-center gap-3 rounded-xl bg-secondary/20 px-3 py-2.5",children:[s.jsxs("div",{className:"flex items-center gap-2 flex-1 text-xs",children:[s.jsx("span",{className:"font-mono text-primary",children:r.from}),s.jsx("span",{className:"text-muted-foreground",children:"→"}),s.jsx("span",{className:"font-mono text-cyan-400",children:r.to})]}),s.jsx("div",{className:"text-[10px] text-muted-foreground font-mono",children:r.txCount>0?`${r.txCount.toLocaleString()} txs`:"—"}),s.jsx("span",{className:`text-[9px] font-bold px-2 py-0.5 rounded-full ${r.status==="active"?"bg-green-500/10 text-green-400":r.status==="pending"?"bg-yellow-500/10 text-yellow-400":"bg-secondary/40 text-muted-foreground"}`,children:r.status})]},n))}),s.jsx("div",{className:"mt-4 grid grid-cols-3 gap-3",children:[["Total BTC Mined",`${e.toFixed(8)} BTC`,"text-yellow-400"],["USD Value",`$${(e*67e3).toFixed(2)}`,"text-green-400"],["BER Equivalent",`${(e*67e6).toFixed(0)} BER`,"text-primary"]].map(([r,n,i])=>s.jsxs("div",{className:"rounded-xl bg-black/20 p-2.5 text-center",children:[s.jsx("div",{className:"text-[9px] text-muted-foreground",children:r}),s.jsx("div",{className:`text-xs font-bold font-mono mt-0.5 ${i}`,children:n})]},r))})]}),s.jsxs("div",{className:"rounded-2xl border border-border/40 bg-card/50 p-5",children:[s.jsxs("h3",{className:"font-display font-bold text-white mb-3 flex items-center gap-2",children:[s.jsx("span",{children:"📝"})," Smart Contract — BERAutoMining.sol"]}),s